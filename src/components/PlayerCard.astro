---
import type { Player } from '../data/players';
interface Props {
  player: Player;
  class?: string;
}
const { player, class: className = '' } = Astro.props;
---

<article class={`group ${className}`}>
  <div class="relative overflow-hidden rounded-2xl aspect-[4/5] bg-[#0e1512]">
    <img
      src={player.photo}
      alt={`${player.nameEn}（背番号${player.no}）`}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      loading="lazy"
    />
  </div>
  <div class="mt-3 md:mt-4">
    <p class="font-display text-xl md:text-2xl tracking-wide group-hover:text-green transition-colors">
      {player.nameEn}
    </p>
  </div>
</article>
