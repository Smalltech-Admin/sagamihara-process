---
// ロゴ：公式カンガルークレスト（実画像）＋ ワードマーク。
interface Props {
  class?: string;
  variant?: 'light' | 'dark'; // 文字色（背景に応じて）
  showText?: boolean;
}
const { class: className = '', variant = 'light', showText = true } = Astro.props;
const textColor = variant === 'dark' ? 'text-ink' : 'text-bone';
---

<a href="/" class={`group inline-flex items-center gap-4 md:gap-5 ${className}`} aria-label="相模原プロセス ホーム">
  <span class="relative shrink-0">
    <img
      src="/images/brand/kangaroo_head.jpg"
      alt="相模原プロセス ロゴ"
      width="44"
      height="44"
      class="w-11 h-11 rounded-full object-cover ring-1 ring-white/15 transition-transform duration-500 group-hover:scale-105"
    />
  </span>
  {
    showText && (
      <span class={`leading-none ${textColor}`}>
        <span class="block font-sans text-[0.72rem] font-bold tracking-[0.36em] text-green">SAGAMIHARA</span>
        <span class="block font-display text-[1.7rem] md:text-[2rem] tracking-wide mt-1.5">PROCESS</span>
      </span>
    )
  }
</a>
